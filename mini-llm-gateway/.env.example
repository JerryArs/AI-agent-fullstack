# 网关鉴权（留空则运行在无鉴权模式，启动会告警）
GATEWAY_AUTH_TOKEN=change-me

# 配置文件路径（默认 config/models.yaml）
GATEWAY_CONFIG=config/models.yaml

# Prompt Bundle 目录（默认取配置文件里的 prompts_dir）
PROMPTS_DIR=prompts/bundles

# 主模型（OpenAI Compatible）
PRIMARY_PROVIDER_MODEL=deepseek-chat
PRIMARY_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 备用模型
BACKUP_PROVIDER_MODEL=deepseek-chat
BACKUP_BASE_URL=https://api.deepseek.com
DEEPSEEK_BACKUP_API_KEY=sk-xxxxxxxxxxxxxxxx
